rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------

    /// True if the caller has a `staff` document whose status is 'active'.
    /// Status is read live on every request, so suspending a staff member
    /// takes effect immediately (the `role` custom claim is only a routing
    /// hint for the app and is never trusted here).
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid))
             .data.status == 'active';
    }

    /// True if the caller is an active staff member with the given role
    /// ('principal' | 'deputyPrincipal' | 'registrar' | 'bursar' |
    /// 'staffMember').
    function isStaffRole(role) {
      return isStaff()
        && get(/databases/$(database)/documents/staff/$(request.auth.uid))
             .data.role == role;
    }

    /// The five coursework marks, each within its weight. Any may be missing
    /// while a draft is unfinished.
    function isMark(marks, part, max) {
      return !(part in marks)
        || (marks[part] is number && marks[part] >= 0 && marks[part] <= max);
    }
    function isCourseworkMarks(marks) {
      return marks is map
        && marks.keys().hasOnly(
             ['practical', 'assignments', 'tests', 'clinical', 'recordBook'])
        && isMark(marks, 'practical', 10)
        && isMark(marks, 'assignments', 5)
        && isMark(marks, 'tests', 5)
        && isMark(marks, 'clinical', 10)
        && isMark(marks, 'recordBook', 10);
    }

    /// A short line of text, which may be blank.
    function isLine(value) {
      return value is string && value.size() <= 200;
    }

    function isPrincipal()      { return isStaffRole('principal'); }
    function isDeputy()         { return isStaffRole('deputyPrincipal'); }
    /// The Deputy Principal has the Principal's day-to-day powers; the places
    /// that must stay Principal-only (creating or terminating the Deputy,
    /// touching the Principal record) use isPrincipal() instead.
    function isPrincipalLevel() { return isPrincipal() || isDeputy(); }
    function isRegistrar()      { return isStaffRole('registrar'); }
    function isBursar()         { return isStaffRole('bursar'); }

    /// Staff who may publish to the Public Space directly. Custom positions
    /// ('staffMember': Askari, Accountant, ...) can read it but not post.
    function isPostingStaff() {
      return isStaff()
        && get(/databases/$(database)/documents/staff/$(request.auth.uid))
             .data.role in ['principal', 'deputyPrincipal', 'registrar', 'bursar'];
    }

    /// TRANSITIONAL (Phase 1). Stands in for the retired single Admin on
    /// every academic collection below, so the existing management screens
    /// keep working. Phase 2 narrows writes to isRegistrar() and leaves the
    /// Principal with view plus status override.
    function isAdmin() {
      return isPrincipalLevel() || isRegistrar();
    }

    /// Principal or Deputy Principal editing someone else's details: the
    /// name and, for custom-position staff, the position title. Never their
    /// own record, never the Principal's record, and the Deputy Principal's
    /// record only by the Principal. Email, role, status and everything
    /// else stay untouched (the email is the login, which only the person
    /// can change).
    function isStaffDetailsEdit(staffId) {
      return isPrincipalLevel()
        && staffId != request.auth.uid
        && resource.data.role != 'principal'
        && (resource.data.role != 'deputyPrincipal' || isPrincipal())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'position', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && (
          (resource.data.role == 'staffMember'
            && request.resource.data.position is string
            && request.resource.data.position.size() >= 2
            && request.resource.data.position.size() <= 60)
          || (resource.data.role != 'staffMember'
            && !('position' in request.resource.data))
        )
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    /// True once the school's Principal has registered (the `system/setup`
    /// marker exists). Until then NOBODY else may register anywhere: the
    /// tutor rules below require this.
    function setupDone() {
      return exists(/databases/$(database)/documents/system/setup);
    }

    /// The very first Principal registering themselves from the app.
    /// Allowed only while no setup marker exists, only for the caller's own
    /// uid, and only as the same atomic batch that creates the marker
    /// (existsAfter/getAfter), so a Principal record can never exist
    /// without the marker. Once the marker exists this is false forever.
    function isFirstPrincipalCreate(staffId) {
      return request.auth != null
        && request.auth.uid == staffId
        && !setupDone()
        && existsAfter(/databases/$(database)/documents/system/setup)
        && getAfter(/databases/$(database)/documents/system/setup)
             .data.principalUid == staffId
        && request.resource.data.keys().hasAll(
             ['name', 'email', 'role', 'status', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'role', 'status', 'createdAt', 'createdBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('.+@.+[.].+')
        && request.resource.data.role == 'principal'
        && request.resource.data.status == 'active'
        && request.resource.data.createdBy == staffId
        && request.resource.data.createdAt == request.time;
    }

    /// True if the requesting user has an active Tutor account.
    /// The tutor document ID MUST equal the Firebase Auth UID — this is
    /// enforced at creation time (see tutors.create below).
    function isActiveTutor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/tutors/$(request.auth.uid))
        && get(/databases/$(database)/documents/tutors/$(request.auth.uid))
             .data.status == 'active';
    }

    /// True if the given tutor is assigned to the given subject.
    /// Relies on tutor_assignments documents using composite IDs:
    /// `{tutorId}_{subjectId}` — see the note on tutor_assignments below.
    /// (Rules paths only allow a whole-segment `$(expr)`, so the composite
    /// ID is built with string concatenation inside one `$()`. The earlier
    /// `$(a)_$(b)` form did not compile, so no rules could be deployed.)
    function isAssignedToSubject(tutorId, subjectId) {
      return exists(
        /databases/$(database)/documents/tutor_assignments/$(tutorId + '_' + subjectId)
      );
    }

    function isTuition(amount) {
      return amount is int && amount > 0 && amount <= 1000000000;
    }

    function isNsinOrEmpty(nsin) {
      return nsin is string
        && (nsin == ''
            || nsin.matches('[A-Z0-9][A-Z0-9/.\\-]{2,29}'));
    }

    function isFeeStamp() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function paymentPath(feeId, paymentId) {
      return /databases/$(database)/documents/student_fees/$(feeId)/payments/$(paymentId);
    }

    // -------------------------------------------------------------------
    // staff — Principal, Deputy Principal, Registrar, Bursar and other staff
    // -------------------------------------------------------------------
    //
    // Doc ID = Firebase Auth uid. Runs on the free Spark plan, so there are
    // no Cloud Functions: the app writes these documents and these rules are
    // the whole security boundary.
    //
    //   - The Principal and the Deputy Principal can list staff and create
    //     registrar, bursar and staffMember accounts. A staffMember is a
    //     custom position (Askari, Accountant, ...) named in `position`.
    //   - Only the Principal can create the Deputy Principal, and only the
    //     Principal can terminate (suspend) them. Termination is one-way:
    //     a Deputy record is never reactivated, a new one is appointed.
    //   - Nobody can create another principal, change the Principal record,
    //     change their own status, or delete staff.
    //   - The first Principal registers themselves from the app (see
    //     isFirstPrincipalCreate and system/setup); nobody else can
    //     register until then.
    //
    // Suspension is enforced here, live on every request (isStaff() reads
    // status), and by the app signing a suspended user out.

    match /staff/{staffId} {
      // A staff member reads their own record (role resolution at login,
      // including when suspended, so the app can explain why). The
      // Principal and Deputy Principal read any record and list all staff.
      allow get: if request.auth != null
        && (request.auth.uid == staffId || isPrincipalLevel());
      allow list: if isPrincipalLevel();

      allow create: if isFirstPrincipalCreate(staffId)
        || (isPrincipalLevel()
          && request.resource.data.keys().hasAll(
               ['name', 'email', 'role', 'status', 'createdAt', 'createdBy'])
          && request.resource.data.keys().hasOnly(
               ['name', 'email', 'role', 'status', 'createdAt', 'createdBy',
                'position'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 100
          && request.resource.data.email is string
          && request.resource.data.email.matches('.+@.+[.].+')
          && (
            request.resource.data.role in ['registrar', 'bursar', 'staffMember']
            || (request.resource.data.role == 'deputyPrincipal' && isPrincipal())
          )
          && (
            (request.resource.data.role == 'staffMember'
              && 'position' in request.resource.data
              && request.resource.data.position is string
              && request.resource.data.position.size() >= 2
              && request.resource.data.position.size() <= 60)
            || (request.resource.data.role != 'staffMember'
              && !('position' in request.resource.data))
          )
          && request.resource.data.status == 'active'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time);

      // Two kinds of update. (1) Suspend / reactivate / terminate. (2) Edit
      // details (isStaffDetailsEdit). First kind: Principal or Deputy Principal, never
      // themselves, never the Principal record, and only the status stamp
      // fields may change. The Deputy's record is the exception: only the
      // Principal can touch it, and only to terminate (active -> suspended).
      allow update: if (isPrincipalLevel()
          && staffId != request.auth.uid
          && resource.data.role != 'principal'
          && (
            resource.data.role != 'deputyPrincipal'
            || (isPrincipal()
                && resource.data.status == 'active'
                && request.resource.data.status == 'suspended')
          )
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt', 'updatedBy'])
          && request.resource.data.status in ['active', 'suspended']
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time)
        || isStaffDetailsEdit(staffId);

      allow delete: if false;
    }

    // -------------------------------------------------------------------
    // staff_positions — the list on the Staff screen (custom positions)
    // -------------------------------------------------------------------
    //
    // Principal, Deputy Principal, Registrar and Bursar are built into the
    // app. Everything else (Askari, Accountant, Clinical Instructor, ...) is
    // a document here, added by the Principal or Deputy Principal. Readable
    // by anyone because the list is shown before sign-in; it holds nothing
    // but job titles. Picking a position grants nothing: accounts are still
    // created under `staff` above.

    match /staff_positions/{positionId} {
      allow read: if true;

      allow create: if isPrincipalLevel()
        && request.resource.data.keys().hasAll(['title', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['title', 'createdAt', 'createdBy'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 60
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isPrincipalLevel();
    }

    // -------------------------------------------------------------------
    // public_posts — the Public Space (announcements, calendar, sports,
    // graduations, performances, gallery, general info)
    // -------------------------------------------------------------------
    //
    // Readable by ANYONE who has the app, no sign-in, but only once
    // published. Principal, Deputy Principal, Registrar and Bursar publish directly; a
    // tutor's post is created 'pending' and goes live only when the
    // Principal or Registrar approves it (tutors self-register, so they
    // must not be able to broadcast to the whole public unreviewed).
    // Posts are not edited: withdraw (archive) and repost instead.

    match /public_posts/{postId} {
      // The public reads published posts. Moderators also see pending and
      // archived ones; authors see their own. A query must filter on
      // status == 'published' to be allowed for the public.
      allow read: if resource.data.status == 'published'
        || isAdmin()
        || (request.auth != null && resource.data.authorId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(
             ['title', 'body', 'category', 'authorId', 'authorName',
              'authorRole', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(
             ['title', 'body', 'category', 'authorId', 'authorName',
              'authorRole', 'status', 'createdAt', 'eventDate', 'mediaUrl',
              'attachments'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 5000
        && request.resource.data.category in
             ['announcement', 'event', 'sports', 'graduation',
              'performance', 'gallery', 'info']
        && (!('eventDate' in request.resource.data)
            || request.resource.data.eventDate is timestamp)
        && (request.resource.data.category != 'event'
            || 'eventDate' in request.resource.data)
        // A video or audio link.
        && (!('mediaUrl' in request.resource.data)
            || (request.resource.data.mediaUrl is string
                && request.resource.data.mediaUrl.matches('https://.+')
                && request.resource.data.mediaUrl.size() <= 500))
        // Names of the files uploaded for this post.
        && (!('attachments' in request.resource.data)
            || (request.resource.data.attachments is list
                && request.resource.data.attachments.size() >= 1
                && request.resource.data.attachments.size() <= 10))
        && (request.resource.data.category != 'gallery'
            || 'attachments' in request.resource.data)
        && (
          // Principal, Deputy Principal, Registrar and Bursar publish
          // directly, under their real role and name.
          (isPostingStaff()
            && request.resource.data.status == 'published'
            && request.resource.data.authorRole ==
                 get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role
            && request.resource.data.authorName ==
                 get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.name)
          ||
          // Tutors submit for review.
          (isActiveTutor()
            && request.resource.data.status == 'pending'
            && request.resource.data.authorRole == 'tutor'
            && request.resource.data.authorName ==
                 get(/databases/$(database)/documents/tutors/$(request.auth.uid)).data.name)
        );

      // Only the status stamp ever changes. Principal / Deputy / Registrar publish
      // or archive; an author can only withdraw (archive) their own post.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && (
          (isAdmin()
            && request.resource.data.status in ['published', 'archived']
            && request.resource.data.reviewedBy == request.auth.uid
            && request.resource.data.reviewedAt == request.time)
          ||
          (resource.data.authorId == request.auth.uid
            && request.resource.data.status == 'archived'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status']))
        );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // timetables — class and exam timetables, school and semester calendars
    // -------------------------------------------------------------------
    //
    // Built by the Academic Registrar in a spreadsheet-style editor. One
    // document holds the whole grid (title, boxes, footnotes), so a save is
    // one atomic write. Only the Registrar creates, edits, publishes and
    // deletes. The Principal and Deputy Principal can read everything,
    // drafts included, but not change it. Everyone else (students, tutors,
    // the public) reads published timetables. `audience` only decides where
    // a timetable is LISTED in the app; any published one is readable by
    // anyone holding the app's public key until students get real sessions
    // (Phase 5).

    match /timetables/{timetableId} {
      function validTimetable(d) {
        return d.keys().hasAll(
               ['title', 'type', 'audience', 'status', 'rows', 'cols',
                'colWidths', 'cells', 'footnotes', 'createdBy', 'createdAt',
                'updatedAt', 'updatedBy'])
          && d.keys().hasOnly(
               ['title', 'type', 'audience', 'status', 'rows', 'cols',
                'colWidths', 'cells', 'footnotes', 'createdBy', 'createdAt',
                'updatedAt', 'updatedBy', 'subtitle', 'academicYear',
                'programType', 'year', 'semester', 'publishedAt'])
          && d.title is string && d.title.size() >= 3 && d.title.size() <= 120
          && d.type in ['class', 'exam', 'calendar', 'semester_calendar', 'custom']
          && d.audience in ['everyone', 'students', 'staff']
          && d.status in ['draft', 'published']
          && d.rows is int && d.rows >= 1 && d.rows <= 60
          && d.cols is int && d.cols >= 1 && d.cols <= 20
          && d.colWidths is list && d.colWidths.size() == d.cols
          && d.cells is map
          && d.footnotes is list && d.footnotes.size() <= 12
          && (!('subtitle' in d)
              || (d.subtitle is string && d.subtitle.size() <= 200))
          && (!('academicYear' in d)
              || (d.academicYear is string && d.academicYear.size() <= 20))
          && (!('programType' in d) || d.programType is string)
          && (!('year' in d) || (d.year is int && d.year >= 0 && d.year <= 3))
          && (!('semester' in d)
              || (d.semester is int && d.semester >= 0 && d.semester <= 2))
          && (!('publishedAt' in d) || d.publishedAt is timestamp);
      }

      allow read: if resource.data.status == 'published'
        || isRegistrar()
        || isPrincipalLevel();

      allow create: if isRegistrar()
        && validTimetable(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if isRegistrar()
        && validTimetable(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if isRegistrar();
    }

    // -------------------------------------------------------------------
    // admins — RETIRED. Replaced by `staff`. Locked entirely; the legacy
    // document is no longer used.
    // -------------------------------------------------------------------

    match /admins/{adminId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------
    // tutors — self-registration, admin-managed status (Section 2.2)
    // -------------------------------------------------------------------

    match /tutors/{tutorId} {
      // Authenticated users can read tutor profiles. Admin lists all
      // tutors; a tutor reads their own profile via AuthProvider.
      allow read: if request.auth != null;

      // Create: self-registration only. The document ID MUST equal the
      // authenticated user's UID. A tutor cannot create a document for
      // a different UID. The incoming document must set status to
      // 'active' — no self-creating with 'suspended' or 'terminated'.
      allow create: if request.auth != null
        && setupDone()
        && request.auth.uid == tutorId
        && request.resource.data.status == 'active'
        && request.resource.data.name is string
        && request.resource.data.email is string;

      // Update: a tutor can update their OWN document only to set
      // status to 'terminated' (self-termination, Section 2.2).
      // Admin can update any tutor's document (suspend, reactivate,
      // terminate) — full field write allowed for admin.
      allow update: if request.auth != null
        && (
          // Tutor self-termination: only the status field, only to 'terminated'
          (request.auth.uid == tutorId
           && request.resource.data.status == 'terminated'
           && resource.data.status == 'active')
          // Admin: unrestricted updates
          || isAdmin()
        );

      // Delete: admin only. Tutors cannot delete their own accounts
      // — self-termination sets status, does not remove the record.
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // tutor_assignments — Admin-only assignment (Section 2.2)
    // -------------------------------------------------------------------
    //
    // IMPORTANT DATA-MODEL DEPENDENCY:
    // These rules assume tutor_assignments documents use composite IDs
    // of the form `{tutorId}_{subjectId}` (e.g. "abc123_xyz789").
    // This enables the `isAssignedToSubject()` function above to check
    // assignment with a single `exists()` call rather than needing a
    // collection-group query (which Firestore rules don't support).
    //
    // If documents are created via Firestore's auto-ID (add()), these
    // rules will not enforce the assignment check for content_items.
    // The corresponding repository method —
    // TutorRepository.assignTutorToSubject() — must use
    //   _assignments.doc('${tutorId}_${subjectId}').set(...)
    // instead of
    //   _assignments.add(...)

    match /tutor_assignments/{assignmentId} {
      // Authenticated users can read assignments. This is how the tutor
      // dashboard's StreamBuilder sees assigned subjects, and how the
      // content_items.create rule checks assignment.
      allow read: if request.auth != null;

      // Create: admin only (tutors cannot self-assign per Section 2.2).
      // The incoming document must contain valid tutorId and subjectId
      // fields, and the document ID must match the composite key.
      allow create: if isAdmin()
        && request.resource.data.tutorId is string
        && request.resource.data.subjectId is string
        && assignmentId == request.resource.data.tutorId + '_' + request.resource.data.subjectId;

      // Update: admin only. Assignment documents are immutable in
      // practice (they only have tutorId, subjectId, assignedAt), but
      // allowing update gives flexibility for future fields.
      allow update: if isAdmin();

      // Delete: admin only (Section 2.2 — removing a tutor's access to
      // a subject).
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // students — Admin-admitted, NSIN-lookup access (Section 2.3)
    // -------------------------------------------------------------------

    match /students/{studentId} {
      // Authenticated users can read student records. The student
      // themselves isn't "authenticated" in the Firebase Auth sense
      // (NSIN-only, no password — Section 2.3), but the StudentProvider
      // performs the lookup while the app is in an unauthenticated
      // state. For the NSIN lookup to work, student documents must be
      // readable without auth.
      //
      // DECISION: allow unauthenticated read of students. The NSIN
      // itself is the access mechanism — a student enters their NSIN
      // and the app looks it up. Without this read, the entire student
      // flow is blocked. The data is non-sensitive (academic info only,
      // per StudentRecord's own doc comment — fees/Bursar data is in a
      // separate collection).
      allow read: if true;

      // Create: admin only (Section 2.3 — students do not self-register;
      // this is the admission-entry action from Section 5 step 4).
      allow create: if isAdmin()
        && request.resource.data.nsin is string
        && request.resource.data.name is string;

      // Update: admin only (Section 2.1 — suspend, terminate, or update
      // a student's record).
      allow update: if isAdmin();

      // Delete: admin only.
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // subjects — Admin-built academic structure (Section 3.3)
    // -------------------------------------------------------------------

    match /subjects/{subjectId} {
      // PUBLIC READ (interim, Spark plan). Students have no Firebase Auth
      // account (NSIN-only access, no password), so a request.auth check
      // would lock them out of their own dashboard. Structure names are
      // non-sensitive. Writes stay admin-only below. Phase 5 replaces this
      // with NSIN-bound student sessions.
      allow read: if true;

      // Create: admin only (Section 2.1 — only Admin builds structure).
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.programType is string
        && request.resource.data.year is int
        && request.resource.data.semester is int;

      // Update: admin only.
      allow update: if isAdmin();

      // Delete: admin only. Note: this does NOT cascade-delete
      // ContentItems or TutorAssignments referencing this subject —
      // that cleanup should be handled server-side (Cloud Function).
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // content_items — Tutor-uploaded files (Section 4.2)
    // -------------------------------------------------------------------

    match /content_items/{itemId} {
      // PUBLIC READ (interim, Spark plan): the student subject viewer lists
      // uploaded items without any sign-in. This exposes item metadata
      // (names, links) to anyone holding the app's public key; the files
      // themselves stay behind Storage rules. Writes stay tutor/admin-only
      // below. Phase 5 replaces this with NSIN-bound student sessions.
      allow read: if true;

      // Create: the uploading tutor must be active AND assigned to the
      // subject they are uploading into. Admin can also upload.
      //
      // This is the concrete enforcement point for Section 2.2's rule
      // that "a tutor cannot upload into a subject they haven't been
      // assigned to" — the client-side check in
      // TutorAuthorizationChecker.isTutorAssignedToSubject() is the
      // first line of defense; this rule is the actual security
      // boundary.
      allow create: if request.auth != null
        && (
          isAdmin()
          || (
            isActiveTutor()
            && request.resource.data.uploadedByTutorId == request.auth.uid
            && isAssignedToSubject(
                 request.auth.uid,
                 request.resource.data.subjectId
               )
          )
        )
        && request.resource.data.subjectId is string
        && request.resource.data.contentTypeId is string
        && request.resource.data.fileName is string
        && request.resource.data.fileUrl is string
        && request.resource.data.storagePath is string
        && request.resource.data.isArchived == false;

      // Update: same assignment gate as create. A tutor can only
      // archive/unarchive/update content they uploaded into a subject
      // they are still assigned to. Admin can update anything.
      allow update: if request.auth != null
        && (
          isAdmin()
          || (
            isActiveTutor()
            && resource.data.uploadedByTutorId == request.auth.uid
            && isAssignedToSubject(
                 request.auth.uid,
                 resource.data.subjectId
               )
          )
        );

      // Delete: same assignment gate. Permanent deletion of the file
      // from Storage is handled client-side (StorageService.deleteFile)
      // before the Firestore document is removed — both layers must
      // allow the operation for it to succeed.
      allow delete: if request.auth != null
        && (
          isAdmin()
          || (
            isActiveTutor()
            && resource.data.uploadedByTutorId == request.auth.uid
            && isAssignedToSubject(
                 request.auth.uid,
                 resource.data.subjectId
               )
          )
        );
    }

    // -------------------------------------------------------------------
    // content_types — Admin-extensible categories (Section 4.3)
    // -------------------------------------------------------------------

    match /content_types/{typeId} {
      // PUBLIC READ (interim, Spark plan): the student subject screen uses
      // these for its filter chips. Non-sensitive. Writes stay admin-only.
      allow read: if true;

      // Create: admin only (Section 4.3 — Admin adds new categories at
      // runtime). ContentRepository.seedDefaultContentTypesIfNeeded()
      // runs during first-run setup (as admin).
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60;

      // Update (rename): admin only, and only the name may change.
      // Existing uploads reference a category by id, so a rename is safe.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60;

      // Delete: admin only. Deleting a category that uploads still point
      // at would orphan them; the rules cannot count documents, so the
      // app refuses to delete a category that is in use (see
      // ContentRepository.deleteContentType).
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // student_fees — tuition per student per semester, kept by the Bursar
    // -------------------------------------------------------------------
    //
    // Fee data is private. Parents and students have no sign-in; they go
    // through the Worker (POST /fees), which checks their answers and reads
    // with a service account. Nothing is ever deleted, and `paid` only moves
    // together with a new payment of the same amount.

    // Which student owns a payment number. A new student may have no NSIN yet
    // (empty); it can be filled in once and never changed after that.
    match /fee_numbers/{number} {
      allow read: if isBursar();
      allow create: if isBursar()
        && number.matches('[A-Z0-9]{4,10}')
        && request.resource.data.keys().hasOnly(['nsin', 'updatedBy', 'updatedAt'])
        && isNsinOrEmpty(request.resource.data.nsin)
        && isFeeStamp();
      allow update: if isBursar()
        && resource.data.nsin == ''
        && request.resource.data.nsin != ''
        && isNsinOrEmpty(request.resource.data.nsin)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nsin', 'updatedBy', 'updatedAt'])
        && isFeeStamp();
      allow delete: if false;
    }

    match /student_fees/{feeId} {
      allow read: if isBursar() || isPrincipalLevel();

      allow create: if isBursar()
        && request.resource.data.keys().hasOnly(
             ['paymentNumber', 'nsin', 'name', 'programType', 'year', 'semester',
              'tuition', 'paid', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['paymentNumber', 'nsin', 'name', 'programType', 'year', 'semester',
              'tuition', 'paid', 'updatedBy', 'updatedAt'])
        && isNsinOrEmpty(request.resource.data.nsin)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.programType in
             ['certificateMidwifery', 'certificateNursing',
              'diplomaDirectMidwifery', 'diplomaDirectNursing',
              'diplomaExtensionMidwifery', 'diplomaExtensionNursing']
        && request.resource.data.year in [1, 2, 3]
        && request.resource.data.semester in [1, 2]
        && request.resource.data.paymentNumber is string
        && getAfter(/databases/$(database)/documents/fee_numbers/$(request.resource.data.paymentNumber))
             .data.nsin == request.resource.data.nsin
        && feeId == request.resource.data.paymentNumber
             + '_Y' + string(request.resource.data.year)
             + 'S' + string(request.resource.data.semester)
        && isTuition(request.resource.data.tuition)
        && request.resource.data.paid is int
        && request.resource.data.paid == 0
        && isFeeStamp();

      allow update: if isBursar()
        && isFeeStamp()
        && (
          // Fill in a missing NSIN, matching the payment number's owner.
          (resource.data.nsin == ''
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nsin', 'updatedBy', 'updatedAt'])
            && request.resource.data.nsin
                 == getAfter(/databases/$(database)/documents/fee_numbers/$(resource.data.paymentNumber))
                      .data.nsin)
          ||
          // Change the tuition.
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['tuition', 'updatedBy', 'updatedAt'])
            && isTuition(request.resource.data.tuition))
          ||
          // Record a payment: a new entry in the same write, same amount.
          (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['paid', 'lastPaymentId', 'updatedBy', 'updatedAt'])
            && !exists(paymentPath(feeId, request.resource.data.lastPaymentId))
            && existsAfter(paymentPath(feeId, request.resource.data.lastPaymentId))
            && request.resource.data.paid == resource.data.paid
                 + getAfter(paymentPath(feeId, request.resource.data.lastPaymentId))
                     .data.amount
            && request.resource.data.paid >= 0)
        );

      allow delete: if false;

      match /payments/{paymentId} {
        allow read: if isBursar() || isPrincipalLevel();

        // Only valid when the parent record points at this entry in the
        // same write, which makes the parent rule check the amount.
        allow create: if isBursar()
          && request.resource.data.keys().hasOnly(
               ['amount', 'method', 'reference', 'recordedBy', 'createdAt'])
          && request.resource.data.keys().hasAll(
               ['amount', 'method', 'reference', 'recordedBy', 'createdAt'])
          && request.resource.data.amount is int
          && request.resource.data.amount != 0
          && request.resource.data.amount >= -1000000000
          && request.resource.data.amount <= 1000000000
          && request.resource.data.method in
               ['bank', 'mobileMoney', 'cash', 'correction']
          && (request.resource.data.amount > 0
              || request.resource.data.method == 'correction')
          && request.resource.data.reference is string
          && request.resource.data.reference.size() >= 1
          && request.resource.data.reference.size() <= 100
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/student_fees/$(feeId))
               .data.lastPaymentId == paymentId;

        allow update, delete: if false;
      }
    }

    // Parent / guardian names for a payment code, used to check parents.
    match /fee_guardians/{number} {
      allow read: if isBursar() || isPrincipalLevel();
      allow create, update: if isBursar()
        && request.resource.data.keys().hasOnly(['names', 'updatedBy', 'updatedAt'])
        && request.resource.data.names is list
        && request.resource.data.names.size() >= 1
        && request.resource.data.names.size() <= 2
        && isFeeStamp();
      allow delete: if false;
    }

    // Student bio data, kept apart from the public `students` collection.
    // Filed under the NSIN (with _ for /) or, before one exists, the payment code.
    match /student_bio/{key} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['dateOfBirth', 'district', 'village', 'primarySchool',
              'secondarySchool', 'updatedBy', 'updatedAt'])
        && request.resource.data.dateOfBirth.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && isFeeStamp();
      allow delete: if false;
    }

    // Coursework as the Registrar holds it, drafts included. Never readable
    // by students: published marks are copied to student_results.
    match /coursework/{id} {
      allow read: if isRegistrar() || isPrincipalLevel();
      allow create, update: if isRegistrar()
        && request.resource.data.keys().hasOnly(
             ['nsin', 'subjectId', 'subjectName', 'programType', 'year',
              'semester', 'marks', 'published', 'pendingChanges',
              'updatedBy', 'updatedAt'])
        && request.resource.data.nsin is string
        && request.resource.data.subjectId is string
        && request.resource.data.published is bool
        && isCourseworkMarks(request.resource.data.marks)
        && isFeeStamp();
      allow delete: if false;
    }

    // Published results, one document per student. Students do not sign in,
    // so whoever knows the student number can open one; nobody can list them.
    match /student_results/{key} {
      allow get: if true;
      allow create, update: if isRegistrar()
        && request.resource.data.keys().hasOnly(
             ['nsin', 'subjects', 'updatedBy', 'updatedAt'])
        && request.resource.data.nsin is string
        && request.resource.data.get('subjects', {}) is map
        && isFeeStamp();
      allow delete: if false;
    }

    // UHPAB results, typed marks and the list of uploaded documents. Students
    // never read this: the Worker does, and applies the fee block.
    match /uhpab_results/{key} {
      allow read: if isRegistrar() || isPrincipalLevel();
      allow create, update: if isRegistrar()
        && request.resource.data.keys().hasOnly(
             ['nsin', 'units', 'documents', 'updatedBy', 'updatedAt'])
        && request.resource.data.nsin is string
        && request.resource.data.get('units', {}) is map
        && request.resource.data.get('documents', {}) is map
        && isFeeStamp();
      allow delete: if false;
    }

    // The Bursar's permission for a student to see UHPAB results despite
    // unpaid or unrecorded fees.
    match /result_clearance/{key} {
      allow read: if isBursar() || isRegistrar() || isPrincipalLevel();
      allow create, update: if isBursar()
        && request.resource.data.keys().hasOnly(
             ['nsin', 'allowed', 'updatedBy', 'updatedAt'])
        && request.resource.data.nsin is string
        && request.resource.data.allowed is bool
        && isFeeStamp();
      allow delete: if false;
    }

    // Disciplinary cases, hidden ones included. Never readable by students:
    // visible cases are copied to student_discipline.
    match /discipline_cases/{id} {
      allow read: if isRegistrar() || isPrincipalLevel();
      allow create, update: if (isRegistrar() || isPrincipalLevel())
        && request.resource.data.keys().hasOnly(
             ['nsin', 'date', 'offence', 'action', 'status', 'visible',
              'updatedBy', 'updatedAt'])
        && request.resource.data.nsin is string
        && (resource == null
            || request.resource.data.nsin == resource.data.nsin)
        && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.offence is string
        && request.resource.data.offence.size() >= 1
        && request.resource.data.offence.size() <= 500
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 500
        && request.resource.data.status in ['open', 'underReview', 'closed']
        && request.resource.data.visible is bool
        && isFeeStamp();
      allow delete: if false;
    }

    // The cases a student may see, one document per student. As with results,
    // whoever knows the student number can open it; nobody can list them.
    match /student_discipline/{key} {
      allow get: if true;
      allow create, update: if (isRegistrar() || isPrincipalLevel())
        && request.resource.data.keys().hasOnly(
             ['nsin', 'cases', 'updatedBy', 'updatedAt'])
        && request.resource.data.nsin is string
        && request.resource.data.get('cases', {}) is map
        && isFeeStamp();
      allow delete: if false;
    }

    // Clinical placements, one document per student. As with results,
    // whoever knows the student number can open it; nobody can list them.
    match /student_placements/{key} {
      allow get: if true;
      allow create, update: if isRegistrar()
        && request.resource.data.keys().hasOnly(
             ['nsin', 'placements', 'updatedBy', 'updatedAt'])
        && request.resource.data.nsin is string
        && request.resource.data.get('placements', {}) is map
        && isFeeStamp();
      allow delete: if false;
    }

    // Attendance, one document per student. A student opens their own by
    // number; only staff may search, to fill a class list.
    match /student_attendance/{key} {
      allow get: if true;
      allow list: if isRegistrar() || isPrincipalLevel();
      allow create, update: if isRegistrar()
        && request.resource.data.keys().hasOnly(
             ['nsin', 'units', 'updatedBy', 'updatedAt'])
        && request.resource.data.nsin is string
        && request.resource.data.get('units', {}) is map
        && isFeeStamp();
      allow delete: if false;
    }

    // The wording on result slips and transcripts.
    match /settings/documents {
      allow get: if isRegistrar() || isPrincipalLevel();
      allow create, update: if isRegistrar()
        && request.resource.data.keys().hasOnly(
             ['schoolName', 'address', 'contact', 'accreditation',
              'slipTitle', 'transcriptTitle', 'signatory1', 'signatory2',
              'footer', 'updatedBy', 'updatedAt'])
        && isLine(request.resource.data.schoolName)
        && isLine(request.resource.data.address)
        && isLine(request.resource.data.contact)
        && isLine(request.resource.data.accreditation)
        && isLine(request.resource.data.slipTitle)
        && isLine(request.resource.data.transcriptTitle)
        && isLine(request.resource.data.signatory1)
        && isLine(request.resource.data.signatory2)
        && isLine(request.resource.data.footer)
        && isFeeStamp();
      allow delete: if false;
    }

    // Student number formats, set by the Academic Registrar. The app checks
    // numbers against them; public, because students check before signing in.
    match /settings/studentNumber {
      allow get: if true;
      allow create, update: if isRegistrar()
        && request.resource.data.keys().hasOnly(['formats', 'updatedBy', 'updatedAt'])
        && request.resource.data.formats is list
        && request.resource.data.formats.size() >= 1
        && request.resource.data.formats.size() <= 5
        && isFeeStamp();
      allow delete: if isRegistrar();
    }

    // fee_attempts (the Worker's guess counter) has no rule: apps are denied.

    // -------------------------------------------------------------------
    // system/setup — "the school has a Principal" marker
    // -------------------------------------------------------------------
    //
    // Anyone may read it (the app checks it at launch, before sign-in) but
    // nobody can list the collection. It is created exactly once, by the
    // first Principal, in the same batch as their own staff record; after
    // that it can never be changed or deleted from a client.

    match /system/{docId} {
      allow get: if docId == 'setup';
      allow list: if false;

      allow create: if docId == 'setup'
        && request.auth != null
        && request.resource.data.keys().hasAll(['principalUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['principalUid', 'createdAt'])
        && request.resource.data.principalUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(
             /databases/$(database)/documents/staff/$(request.auth.uid))
        && getAfter(
             /databases/$(database)/documents/staff/$(request.auth.uid))
             .data.role == 'principal';

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------
    // Default deny — anything not explicitly matched above is blocked
    // -------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
