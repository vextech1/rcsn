rules_version = '2';

// Firebase Storage is not used by the app: files are stored through the
// storage Worker (docs/STORAGE.md). Deny everything so a signed-in account,
// including one anyone can self-register, cannot read, write or delete here.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
