rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Tutor uploads live under subjects/{subjectId}/content/. Any signed-in
    // user may read; writes are capped at 100MB (matches UploadRules in the
    // app). Tighten to assigned tutors in a later phase (see docs/PLAN.md).
    match /subjects/{subjectId}/content/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
  }
}
